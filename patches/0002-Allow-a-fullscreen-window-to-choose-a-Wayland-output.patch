From 6b65ff58029b0a7f8c54c7ce73a77d12443f0397 Mon Sep 17 00:00:00 2001
From: nava <nava@noreply.com>
Date: Thu, 22 Oct 2026 05:05:42 +0000
Subject: [PATCH] Allow a fullscreen window to choose a Wayland output

---
 host.hh            |  4 ++++
 os/wayland_host.cc | 16 ++++++++++++++--
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/host.hh b/host.hh
index ccfea07..956db20 100644
--- a/host.hh
+++ b/host.hh
@@ -94,6 +94,10 @@ struct WindowOptions {
     int width = 1200;
     int height = 700;
     bool fullscreen = true;
+    // Wayland connector name to fullscreen on, e.g. "DP-2". Empty means the
+    // compositor chooses. A windowed request cannot be positioned by a Wayland
+    // client; this only selects the output for a fullscreen request.
+    std::string output;
 };
 
 // Owns the real OS window handle and drives every window/monitor/input/
diff --git a/os/wayland_host.cc b/os/wayland_host.cc
index addc384..3211a8d 100644
--- a/os/wayland_host.cc
+++ b/os/wayland_host.cc
@@ -51,7 +51,7 @@ public:
     void setFullscreen(bool on) override {
         if (!window_) return;
         if (on) {
-            window_->set_fullscreen(nullptr);
+            window_->set_fullscreen(find_output(outputName_));
         } else {
             window_->unset_fullscreen();
         }
@@ -82,8 +82,9 @@ public:
         // Fullscreen only when asked for. The compositor answers with a
         // configure asynchronously (unlike Windows' synchronous SetWindowPos),
         // and pump() calls onHostResized() once that resize actually lands.
+        outputName_ = windowOptions_.output;
         if (windowOptions_.fullscreen) {
-            window_->set_fullscreen(nullptr);
+            window_->set_fullscreen(find_output(outputName_));
         }
 
         seekTimerFd_ = timerfd_create(CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC);
@@ -360,6 +361,16 @@ public:
     }
 
 private:
+    wl_output* find_output(const std::string& name) {
+        if (name.empty() || !display_) return nullptr;
+        for (const WaylandOutput& output : display_->outputs()) {
+            if (output.name == name && output.output != nullptr) return output.output;
+        }
+        fprintf(stderr, "[LinuxHost] output \"%s\" not found; compositor chooses\n",
+                name.c_str());
+        return nullptr;
+    }
+
     struct Event { int id; intptr_t p1, p2; };
 
     int timerId_ = 0;
@@ -373,6 +384,7 @@ private:
     WindowOptions windowOptions_;
     std::unique_ptr<WaylandDisplay> display_;
     std::unique_ptr<WaylandWindow> window_;
+    std::string outputName_;
     std::unique_ptr<WaylandSurfaceProvider> surfaceProvider_;
     FileAssetReader assets_;
     FileByteReader  dataReader_;
-- 
2.56.0

