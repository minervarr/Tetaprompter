From f36f0700df131220a8c210e427fe28816fed42b3 Mon Sep 17 00:00:00 2001
From: nava <nava@noreply.com>
Date: Thu, 22 Oct 2026 05:02:35 +0000
Subject: [PATCH] Add fullscreen switching and CLI console restoration

---
 app_main.hh        |  6 ++++++
 host.hh            |  8 ++++++++
 os/wayland_host.cc | 27 +++++++++++++++++++++++++++
 3 files changed, 41 insertions(+)

diff --git a/app_main.hh b/app_main.hh
index 3fa23d5..95b7d25 100644
--- a/app_main.hh
+++ b/app_main.hh
@@ -27,6 +27,12 @@
 // it constructs the app and the AndroidHost directly.
 int app_shell_main(int argc, char** argv);
 
+// Undo the desktop bootstrap's log-file redirection, restoring the process's
+// original stdout/stderr. A bootstrap redirects only when there is no terminal
+// (a desktop launch), but a CLI mode (`--print-timing`, `--check`, `--help`) is
+// still talking to a pipe and must be allowed to answer there.
+void app_shell_restore_console();
+
 // ── The two strings an application gives its shell ──────────────────────────
 //
 // A log file and a window class have to be CALLED something, and only the app
diff --git a/host.hh b/host.hh
index 085a274..ccfea07 100644
--- a/host.hh
+++ b/host.hh
@@ -119,6 +119,14 @@ public:
     // not implemented it (Win32 today) keeps the mode the app has always got.
     virtual void setWindowOptions(const WindowOptions&) {}
 
+    // Switch an existing window between fullscreen and windowed mode.
+    //
+    // Wayland answers asynchronously with a configure; the host reports the
+    // resulting size through onHostResized(), exactly as it does for an
+    // interactive resize. Defaulted to a no-op for hosts without a windowing
+    // mode (Android) or without the implementation yet.
+    virtual void setFullscreen(bool) {}
+
     // Portable executable-relative directory, UTF-8, trailing separator.
     // (GetModuleFileNameW-derived on Windows, /proc/self/exe on Linux —
     // same discovery FileAssetReader's own per-platform impl already uses.)
diff --git a/os/wayland_host.cc b/os/wayland_host.cc
index f8aecb9..addc384 100644
--- a/os/wayland_host.cc
+++ b/os/wayland_host.cc
@@ -48,6 +48,15 @@ public:
 
     void setWindowOptions(const WindowOptions& options) override { windowOptions_ = options; }
 
+    void setFullscreen(bool on) override {
+        if (!window_) return;
+        if (on) {
+            window_->set_fullscreen(nullptr);
+        } else {
+            window_->unset_fullscreen();
+        }
+    }
+
     bool init(AppView* owner) override {
         owner_ = owner;
         if (!display_->valid()) {
@@ -408,6 +417,9 @@ void crashHandler(int sig) {
     raise(sig);
 }
 
+int g_saved_stdout = -1;
+int g_saved_stderr = -1;
+
 void openLogFile() {
     // Only when there is no terminal to print to.
     //
@@ -422,6 +434,8 @@ void openLogFile() {
     // stays right under a pipe or a redirect, where the caller has already said
     // where output should go.
     if (isatty(fileno(stdout))) return;
+    g_saved_stdout = dup(fileno(stdout));
+    g_saved_stderr = dup(fileno(stderr));
     // app_paths::stateDir() (not the exe's own directory) so a read-only
     // install still gets a log — see app_paths.hh. Identical to the old path
     // unless MATRIX_STATE_HOME was defined at build time. This is the FIRST
@@ -444,6 +458,19 @@ void openLogFile() {
 
 } // namespace
 
+void app_shell_restore_console() {
+    if (g_saved_stdout >= 0) {
+        dup2(g_saved_stdout, fileno(stdout));
+        close(g_saved_stdout);
+        g_saved_stdout = -1;
+    }
+    if (g_saved_stderr >= 0) {
+        dup2(g_saved_stderr, fileno(stderr));
+        close(g_saved_stderr);
+        g_saved_stderr = -1;
+    }
+}
+
 int main(int argc, char** argv) {
     openLogFile();
     signal(SIGSEGV, crashHandler);
-- 
2.56.0

